APP_ENV=development

POSTGRES_USER=tone_neuron
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=tone_neuron_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=onboarding@resend.dev

OTP_EXPIRE_MINUTES=3
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

REDIS_URL=redis://127.0.0.1:6380/0

LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_FAILURE_WINDOW_SECONDS=900

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

MAX_REQUEST_SIZE_BYTES=1048576
REQUEST_LOGGING_ENABLED=true

ANALYTICS_RETENTION_DAYS=90
SECURITY_EVENT_RETENTION_DAYS=180

ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_API_KEY=REPLACE_WITH_RANDOM_INTERNAL_KEY
ML_SERVICE_TIMEOUT_SECONDS=60
ML_SERVICE_CONNECT_TIMEOUT_SECONDS=5

DATABASE_URL_OVERRIDE=
